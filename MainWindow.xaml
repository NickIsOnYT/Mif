<Window x:Class="Mif.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mif – Image sequence to video / GIF"
        Height="580" Width="780"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#1a1b26">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu: Advanced opens settings directly; Import folder -->
        <Menu Grid.Row="0" Margin="0,0,0,8" Background="#16161e" Foreground="#a9b1d6">
            <MenuItem Header="Advanced" Click="AdvancedSettings_Click"/>
        </Menu>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnAddFrames" Content="Add images…" Click="BtnAddFrames_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnImportFolder" Content="Import folder…" Click="ImportFolder_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnRemoveFrame" Content="Remove selected" Click="BtnRemoveFrame_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnClear" Content="Clear all" Click="BtnClear_Click" Margin="0,0,16,0"/>
            <TextBlock Text="Default delay (1/100 sec):" VerticalAlignment="Center" Foreground="#a9b1d6" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtFrameDelay" Width="60" VerticalAlignment="Center" Padding="6,4"
                     Text="50" ToolTip="Default delay per frame in hundredths of a second (e.g. 50 = 0.5 s)"/>
            <TextBlock Text="(e.g. 50 = 0.5 s)" VerticalAlignment="Center" Foreground="#565f89" Margin="8,0,0,0" FontSize="11"/>
        </StackPanel>

        <!-- Frame stack -->
        <Border Grid.Row="2"
                BorderBrush="#3b4261"
                BorderThickness="1"
                CornerRadius="4"
                Background="#16161e"
                Padding="8"
                HorizontalAlignment="Stretch"
                AllowDrop="True"
                DragEnter="FrameArea_DragEnter"
                DragOver="FrameArea_DragOver"
                Drop="FrameArea_Drop">
            <Grid>
                <TextBlock x:Name="TxtNoFrames" Text="No frames. Click “Add images…” to add pictures."
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="#565f89" FontSize="14"/>
                <ListBox x:Name="FrameList"
                         Visibility="Collapsed"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="FrameList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#24283b"
                                    CornerRadius="4"
                                    Padding="8"
                                    Margin="0,2"
                                    HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0"
                                           Source="{Binding Thumbnail}"
                                           Stretch="Uniform"
                                           MaxHeight="60"
                                           MaxWidth="80"
                                           Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="{Binding FileName}" Foreground="#a9b1d6" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SizeText}" Foreground="#565f89" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,8,0">
                                        <TextBlock Text="Frame delay"
                                                   Foreground="#a9b1d6"
                                                   FontSize="10"
                                                   Margin="0,0,0,2"
                                                   TextAlignment="Right"/>
                                        <TextBox Text="{Binding DelayOverrideText, UpdateSourceTrigger=LostFocus}"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Right"
                                                 Padding="4,2"
                                                 Width="50"
                                                 ToolTip="Frame delay (1/100 s); leave empty for default"/>
                                    </StackPanel>
                                    <Grid Grid.Column="3"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,4,0">
                                            <TextBlock Text="Frame order"
                                                       Foreground="#a9b1d6"
                                                       FontSize="10"
                                                       Margin="0,0,0,2"
                                                       TextAlignment="Right"/>
                                            <TextBox Width="40"
                                                     Padding="4,2"
                                                     Text="{Binding Position, UpdateSourceTrigger=LostFocus}"
                                                     Tag="{Binding}"
                                                     ToolTip="Frame position (1 = first). Change to move frame."
                                                     LostFocus="FramePosition_LostFocus"
                                                     PreviewKeyDown="FramePosition_PreviewKeyDown"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="✕"
                                                Width="24"
                                                Height="24"
                                                MinWidth="24"
                                                MinHeight="24"
                                                MaxWidth="24"
                                                MaxHeight="24"
                                                Margin="4,0,0,0"
                                                Padding="0"
                                                FontSize="14"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Tag="{Binding}"
                                                Click="BtnRemoveThisFrame_Click"
                                                ToolTip="Remove this frame"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Export -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnExportGif" Content="Export as GIF" Click="BtnExportGif_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnExportVideo" Content="Export as video" Click="BtnExportVideo_Click"/>
        </StackPanel>
    </Grid>
</Window>
