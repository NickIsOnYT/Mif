<Window x:Class="Mif.AdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced settings"
        Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1a1b26">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Default export folder -->
        <TextBlock Grid.Row="0" Text="Default export folder" Foreground="#a9b1d6" Margin="0,0,0,6"/>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtDefaultFolder" Grid.Column="0" Padding="8,6" Margin="0,0,8,0"
                     Background="#24283b" Foreground="#a9b1d6" BorderBrush="#3b4261" CaretBrush="#a9b1d6"/>
            <Button Grid.Column="1" Content="Browse…" Click="BrowseFolder_Click" Padding="12,6"/>
        </Grid>

        <CheckBox x:Name="ChkUseDefaultFolderOnly" Grid.Row="2" Content="Use default folder only (skip save dialog; auto-generated filename)"
                  Foreground="#a9b1d6" Margin="0,0,0,12" IsChecked="False"/>

        <!-- Export resolution -->
        <TextBlock Grid.Row="3" Text="Export resolution (width × height; leave 0 to use source size)" Foreground="#a9b1d6" Margin="0,0,0,6"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox x:Name="TxtExportWidth" Width="70" Padding="8,6" Margin="0,0,8,0"
                     Background="#24283b" Foreground="#a9b1d6" BorderBrush="#3b4261" CaretBrush="#a9b1d6"/>
            <TextBlock Text="×" VerticalAlignment="Center" Foreground="#a9b1d6" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtExportHeight" Width="70" Padding="8,6"
                     Background="#24283b" Foreground="#a9b1d6" BorderBrush="#3b4261" CaretBrush="#a9b1d6"/>
        </StackPanel>

        <!-- GIF colors -->
        <TextBlock Grid.Row="5" Text="GIF color count (2–256; 256 = full palette)" Foreground="#a9b1d6" Margin="0,0,0,6"/>
        <ComboBox x:Name="CmbGifColors" Grid.Row="6" Padding="8,6" Margin="0,0,0,6"
                  Background="#24283b" Foreground="#000000">
            <ComboBoxItem Content="2" Tag="2"/>
            <ComboBoxItem Content="4" Tag="4"/>
            <ComboBoxItem Content="8" Tag="8"/>
            <ComboBoxItem Content="16" Tag="16"/>
            <ComboBoxItem Content="32" Tag="32"/>
            <ComboBoxItem Content="64" Tag="64"/>
            <ComboBoxItem Content="128" Tag="128"/>
            <ComboBoxItem Content="256" Tag="256" IsSelected="True"/>
        </ComboBox>

        <CheckBox x:Name="ChkFirstFrameAsBackground" Grid.Row="7" Content="Use first frame as background (GIF)"
                  Foreground="#a9b1d6" Margin="0,0,0,12" IsChecked="False"/>

        <TextBlock Grid.Row="8" Text="GIF loop count (0 = infinite)" Foreground="#a9b1d6" Margin="0,0,0,6"/>
        <TextBox x:Name="TxtGifLoopCount" Grid.Row="9" Width="100" Padding="8,6" Margin="0,0,0,12" HorizontalAlignment="Left"
                 Background="#24283b" Foreground="#a9b1d6" BorderBrush="#3b4261" CaretBrush="#a9b1d6"/>

        <CheckBox x:Name="ChkDontStackFrames" Grid.Row="10" Content="Don't stack frames (clear each frame before drawing)"
                  Foreground="#a9b1d6" Margin="0,0,0,16" IsChecked="False"/>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Click="Ok_Click" Padding="20,8" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Cancel" Click="Cancel_Click" Padding="20,8" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
